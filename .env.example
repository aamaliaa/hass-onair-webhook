# On-Air Meeting Status Configuration
# Copy this to .env and fill in your values

# Home Assistant Webhook URL (REQUIRED)
# Get this from your Home Assistant webhook automation
HA_WEBHOOK_URL=http://homeassistant.local:8123/api/webhook/YOUR_WEBHOOK_ID_HERE

# Home Assistant base URL for reachability check (REQUIRED)
# Webhooks are skipped when HA is not reachable (e.g. away from home)
HA_BASE_URL=http://homeassistant.local:8123

# How often to check meeting status (in seconds)
CHECK_INTERVAL=5

# Log file location (optional)
# LOG_FILE=/tmp/on_air.log

# Directory containing toggle_meeting.sh — used by the toolbar app (optional)
# Defaults to common locations (~/.hass-onair-webhook, ~/hass-onair-webhook, etc.)
# ONAIR_SCRIPT_DIR=/path/to/hass-onair-webhook
